{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    "packages/wot-core": {
      "package-name": "@web_of_trust/core",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/adapter-yjs": {
      "package-name": "@web_of_trust/adapter-yjs",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/adapter-automerge": {
      "package-name": "@web_of_trust/adapter-automerge",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/wot-relay": {
      "package-name": "@web_of_trust/relay",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/wot-vault": {
      "package-name": "@web_of_trust/vault",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/wot-profiles": {
      "package-name": "@web_of_trust/profiles",
      "changelog-path": "CHANGELOG.md"
    },
    "apps/demo": {
      "release-type": "simple",
      "component": "app",
      "include-component-in-tag": true,
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        { "type": "generic", "path": "android/version.properties" }
      ]
    }
  },
  "separate-pull-requests": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "plugins": ["node-workspace"]
}
